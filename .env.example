# Copy to .env (git-ignored). Never commit real values.
DATABASE_URL=postgres://oa:CHANGE_ME@127.0.0.1:5433/options_aggregator
# READ_ONLY (default) or SIMULATION in a default build.
OA_TRADING_MODE=READ_ONLY
# Loopback by default. A non-loopback address requires OA_API_TOKEN.
OA_BIND=127.0.0.1:8080
# Optional bearer token for the API (and for oa-mcp). Leave empty for local loopback use.
OA_API_TOKEN=
RUST_LOG=info
