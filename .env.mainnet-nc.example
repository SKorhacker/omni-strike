# MAINNET NON-CUSTODIAL profile — copy to .env.mainnet-nc (git-ignored). REAL FUNDS.
# End users sign every order (or send every transaction) from their own wallet: this server holds
# no key and cannot move funds. There is no user key in this file, on purpose.
# Procedure: docs/mainnet-noncustodial.md
#   cargo build --release -p oa-app --features mainnet-nc --bin oa-server --target-dir target/mainnet-nc
#   OA_ENV_FILE=.env.mainnet-nc ./target/mainnet-nc/release/oa-server

# --- Server ---------------------------------------------------------------------------------
# Separate database, REQUIRED (name must contain "mainnet_nc").
DATABASE_URL=postgres://oa:CHANGE_ME@127.0.0.1:5433/options_aggregator_mainnet_nc
OA_TRADING_MODE=MAINNET_NONCUSTODIAL
OA_BIND=127.0.0.1:8082
# Bearer token: REQUIRED as soon as the bind is not loopback.
OA_API_TOKEN=
# Require an integrator key (os_...) on every call.
OA_REQUIRE_API_KEY=false
RUST_LOG=info

# --- Safety -----------------------------------------------------------------------------------
# Every order is refused unless this is exactly "false".
OA_KILL_SWITCH=true
# Server-wide caps in USDC (hard ceilings 25000 / 100000 in the code). Selling is disabled.
OA_MAINNET_MAX_ORDER_USD=100
OA_MAINNET_MAX_SESSION_USD=500
# Rolling window of the session cap, read from the order journal (1..720 hours).
OA_SESSION_WINDOW_HOURS=24

# --- Venues (each one opt-in; all user-signed) ------------------------------------------------
OA_DERIVE_NONCUSTODIAL=true
OA_AEVO_NONCUSTODIAL=false
OA_PARADEX_NONCUSTODIAL=false
OA_THETANUTS_NONCUSTODIAL=false
# Your address for the Thetanuts OptionBook referral fee split (optional).
OA_THETANUTS_REFERRER=
OA_CALLPUT_NONCUSTODIAL=false
OA_HYPERCALL_NONCUSTODIAL=false
OA_HYPERLIQUID_NONCUSTODIAL=false
OA_LIMITLESS_NONCUSTODIAL=false
