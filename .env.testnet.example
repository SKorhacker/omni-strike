# TESTNET profile — copy to .env.testnet (git-ignored) and fill it on your machine only.
# Use NEW wallets / accounts that never hold real funds. Procedure: docs/testnet.md
# Build + run:
#   cargo build --release -p oa-app --features testnet --bin oa-server --target-dir target/testnet
#   OA_ENV_FILE=.env.testnet ./target/testnet/release/oa-server

# --- Server ---------------------------------------------------------------------------------
# Separate database, REQUIRED (name must contain "testnet").
DATABASE_URL=postgres://oa:CHANGE_ME@127.0.0.1:5433/options_aggregator_testnet
OA_TRADING_MODE=TESTNET
# Own port so a read-only server (8080) can run at the same time.
OA_BIND=127.0.0.1:8081
# Optional bearer token for the API (leave empty on loopback).
OA_API_TOKEN=
RUST_LOG=info
# Kill switch: orders are refused unless this is exactly "false".
OA_KILL_SWITCH=true
# MCP may execute testnet routes only if "true".
OA_MCP_ALLOW_TESTNET_EXECUTION=false
# User-signed Derive executor instead of the custodial one (web wallet flow on Sepolia).
OA_DERIVE_NONCUSTODIAL=false

# --- Aevo testnet (REST https://api-testnet.aevo.xyz, EIP-712 "Aevo Testnet", chainId 11155111)
# Test wallet address that owns the account (= order maker).
OA_AEVO_TESTNET_WALLET=
OA_AEVO_TESTNET_API_KEY=
OA_AEVO_TESTNET_API_SECRET=
# PRIVATE key (0x + 64 hex) of the registered SIGNING key — not the wallet key.
# `python scripts/testnet_aevo.py register` generates and registers one.
OA_AEVO_TESTNET_SIGNING_KEY=

# --- Derive v3 testnet (REST https://testnet.api.derive.xyz/v3, chainId 11155111)
# Wallet that owns the subaccount, subaccount id, and the PRIVATE key that signs orders
# (session key with trade scope only, or a throwaway wallet's own key).
OA_DERIVE_TESTNET_WALLET=
OA_DERIVE_TESTNET_SUBACCOUNT_ID=
OA_DERIVE_TESTNET_SIGNER_KEY=

# --- CEX test environments (separate test accounts, never a withdrawal permission)
OA_OKX_DEMO_API_KEY=
OA_OKX_DEMO_API_SECRET=
OA_OKX_DEMO_PASSPHRASE=
OA_BYBIT_TESTNET_API_KEY=
OA_BYBIT_TESTNET_API_SECRET=
OA_DERIBIT_TESTNET_CLIENT_ID=
OA_DERIBIT_TESTNET_CLIENT_SECRET=
