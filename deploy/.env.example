# Omni Strike — container deployment environment.
# Copy to deploy/.env (git-ignored, excluded from the Docker build context), fill LOCALLY, chmod 600.
# Never commit real values. Every value below is a placeholder.
#
# This single file is used twice by docker compose (run from deploy/):
#   1. variable interpolation in docker-compose.yml (OA_PG_PASSWORD, OA_DOMAIN, image tags, ...)
#   2. env_file for the oa-server container (every OA_* / RUST_LOG line below).
# Empty value = "unset" for the server (it trims and ignores empty strings).

# =============================================================================================
# Images
# =============================================================================================
# Tag of omni-strike/oa-server. "latest" = mainnet read-only build. A testnet build is a separate
# tag ("testnet", built with --build-arg CARGO_FEATURES=testnet) and must NOT be used in production.
OA_IMAGE_TAG=latest
OA_WEB_IMAGE_TAG=latest

# =============================================================================================
# PostgreSQL (compose service "db")
# =============================================================================================
# Generate: openssl rand -hex 32   (hex only: the value is embedded in DATABASE_URL unescaped)
OA_PG_PASSWORD=CHANGE_ME_hex_only
# DATABASE_URL is BUILT by docker-compose.yml from OA_PG_PASSWORD (postgres://oa:...@db:5432/
# options_aggregator) and overrides anything here. Only set it when running oa-server outside
# compose. NOTE: the binary is compiled without sqlx TLS support -> plain TCP to Postgres only
# (fine on the private compose network; NOT for a managed database over the internet).
# DATABASE_URL=postgres://oa:CHANGE_ME@db:5432/options_aggregator

# =============================================================================================
# oa-server: core (config.rs, bin/server.rs)
# =============================================================================================
# READ_ONLY (default) | SIMULATION. TESTNET only in a --features testnet image AND with a database
# whose name contains "testnet". LIVE is always refused at startup.
OA_TRADING_MODE=READ_ONLY
# Listen address inside the container. Compose forces 0.0.0.0:8080. A non-loopback bind REQUIRES
# OA_API_TOKEN (the server refuses to start otherwise). The image HEALTHCHECK probes port 8080.
OA_BIND=0.0.0.0:8080
# Bearer token for /v1/* (legacy single-tenant key). REQUIRED with a non-loopback bind.
# Generate: openssl rand -hex 32
OA_API_TOKEN=
# Bearer token for /v1/admin/* (integrator management). Ignored (admin disabled) if < 24 chars.
# Use >= 32 random bytes: openssl rand -hex 32. Leave empty to disable admin endpoints entirely.
OA_ADMIN_TOKEN=
# "true" = every /v1 call needs an integrator API key (or OA_API_TOKEN). Default false.
OA_REQUIRE_API_KEY=false
# Max wait (ms) for uncached venue books per comparison. Default 220, clamped to [50, 15000].
OA_LATENCY_BUDGET_MS=220
# Max concurrent comparisons (protects upstream venues on cold books). Default 512, [1, 100000].
OA_MAX_CONCURRENT_COMPARES=512
# Global in-flight HTTP request cap; above it -> 503 SERVICE_BUSY. Default 4096.
OA_MAX_INFLIGHT=4096
# Keep-warm refresh of hot books for non-streaming venues. Any value but "off" = on (default on).
OA_HOT_REFRESH=on
# Bulk top-of-book polling per venue. Any value but "off" = on (default on).
OA_BULK_TOPS=on
# Live "router vs Derive" dashboard tracker. "off" disables it (default on).
OA_LIVE=on
# Per-client-IP limit (req/s, burst 2x) for callers without an integrator key, e.g. the public
# web UI through Caddy (client IP from X-Forwarded-For). 0 = off. Default 10.
OA_PUBLIC_RPS=10
# Simulations older than this are purged hourly (expired quotes / prepared executions after 1 day).
OA_SIMULATION_RETENTION_DAYS=30
# Log filter (tracing EnvFilter syntax), e.g. info | info,oa_app=debug
RUST_LOG=info
# File the binary tries to load with dotenvy. The image points it at a non-existent path so only
# the container environment is used. Leave unset here.
# OA_ENV_FILE=

# =============================================================================================
# Reverse proxy (compose profile "proxy", deploy/Caddyfile)
# =============================================================================================
# Public DNS name pointing at this host; Caddy obtains the TLS certificate automatically.
OA_DOMAIN=omni.example.com
# ACME account e-mail (expiry notices).
ACME_EMAIL=ops@example.com

# =============================================================================================
# Monitoring (compose profile "monitoring")
# =============================================================================================
# Generate: openssl rand -hex 24
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# =============================================================================================
# TESTNET ONLY — never set in a production (mainnet) deployment. Read only by a
# --features testnet image running with OA_TRADING_MODE=TESTNET. See .env.testnet.example and
# docs/testnet*.md. Kept here commented so the full variable inventory is in one place.
# =============================================================================================
# Orders are refused unless this is exactly "false". Default true.
# OA_KILL_SWITCH=true
# (oa-mcp only) allow MCP to execute testnet routes. Default false.
# OA_MCP_ALLOW_TESTNET_EXECUTION=false
# (oa-mcp only) API base URL. Default http://127.0.0.1:8080.
# OA_API_URL=http://127.0.0.1:8080
# OA_AEVO_TESTNET_WALLET=
# OA_AEVO_TESTNET_API_KEY=
# OA_AEVO_TESTNET_API_SECRET=
# OA_AEVO_TESTNET_SIGNING_KEY=
# OA_DERIVE_TESTNET_WALLET=
# OA_DERIVE_TESTNET_SUBACCOUNT_ID=
# OA_DERIVE_TESTNET_SIGNER_KEY=
# OA_OKX_DEMO_API_KEY=
# OA_OKX_DEMO_API_SECRET=
# OA_OKX_DEMO_PASSPHRASE=
# cash | cross | isolated (optional override)
# OA_OKX_DEMO_TD_MODE=
# OA_BYBIT_TESTNET_API_KEY=
# OA_BYBIT_TESTNET_API_SECRET=
# OA_DERIBIT_TESTNET_CLIENT_ID=
# OA_DERIBIT_TESTNET_CLIENT_SECRET=
