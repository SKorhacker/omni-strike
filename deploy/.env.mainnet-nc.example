# Omni Strike — MAINNET NON-CUSTODIAL container stack (docker-compose.mainnet-nc.yml).
# Copy to deploy/.env.mainnet-nc (git-ignored), fill ON THE SERVER, chmod 600. Never share values in
# chat or tickets. There is NO user key in this file, on purpose: end users sign in their wallet.
# Used for compose interpolation (--env-file) AND as the oa-server env_file.

# --- Images -----------------------------------------------------------------------------------
# Tag suffix: images are omni-strike/oa-server:mainnet-nc-<tag>. Use the git SHA in production.
OA_IMAGE_TAG=latest
OA_WEB_IMAGE_TAG=latest

# --- Secrets (generate each with: openssl rand -hex 32) ---------------------------------------
OA_PG_PASSWORD=CHANGE_ME_hex_only
# Bearer token of the API. Caddy injects it into the web UI's /api/* calls (Caddyfile.mainnet-nc).
OA_API_TOKEN=
# Admin endpoints (integrator keys). Empty = disabled. Always blocked publicly by Caddy.
OA_ADMIN_TOKEN=

# --- Public entry point (profile "proxy") ------------------------------------------------------
# DNS A/AAAA record of this domain must point at the VPS before `--profile proxy up`.
OA_DOMAIN=app.example.com
ACME_EMAIL=ops@example.com

# --- Server -----------------------------------------------------------------------------------
# DATABASE_URL, OA_BIND and OA_TRADING_MODE are set by the compose files.
# The public web UI calls the API without an integrator key: keep false while the UI is public.
OA_REQUIRE_API_KEY=false
# Per-client-IP limit (req/s, burst 2x) for callers without an integrator key, e.g. the public
# web UI through Caddy (client IP from X-Forwarded-For). 0 = off. Default 10.
OA_PUBLIC_RPS=10
# Simulations older than this are purged hourly (expired quotes / prepared executions after 1 day).
OA_SIMULATION_RETENTION_DAYS=30
RUST_LOG=info
OA_LOG_FORMAT=json

# --- Safety -----------------------------------------------------------------------------------
# Every order is refused unless this is exactly "false". Flip it only after the checks in
# docs/deployment.md ("Mainnet non-custodial on a VPS").
OA_KILL_SWITCH=true
# SERVER-WIDE caps in USDC (all users together), hard ceilings 25000 / 100000 in the code.
# The session cap is the committed spend over a rolling window read from the order journal: it
# survives restarts and is shared by every instance.
OA_MAINNET_MAX_ORDER_USD=100
OA_MAINNET_MAX_SESSION_USD=500
OA_SESSION_WINDOW_HOURS=24

# --- Venues (opt-in; the web UI signs Derive, Thetanuts and CallPut) ---------------------------
OA_DERIVE_NONCUSTODIAL=true
OA_THETANUTS_NONCUSTODIAL=false
OA_THETANUTS_REFERRER=
OA_CALLPUT_NONCUSTODIAL=false
# SDK / integrator only (need an API secret, an HMAC or a Starknet account on the client side):
OA_AEVO_NONCUSTODIAL=false
OA_PARADEX_NONCUSTODIAL=false
OA_HYPERCALL_NONCUSTODIAL=false
OA_HYPERLIQUID_NONCUSTODIAL=false
OA_LIMITLESS_NONCUSTODIAL=false
